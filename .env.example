# ============================================================
# AspidusCRM V22.04.05 — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!
# ============================================================

# ── Core (REQUIRED) ──────────────────────────────────────────

# Flask session signing key.
# MUST be the same across redeploys or users will be logged out.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Fernet key for encrypting sensitive data (SMTP passwords, KYC, permissions).
# MUST be the same across redeploys or previously encrypted data becomes unreadable.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Initial admin credentials.
# ADMIN_PASSWORD is REQUIRED — if unset, a random password is generated and printed
# to the server log on first startup. Change it immediately after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Session / Security ───────────────────────────────────────

# Set to "true" when running behind HTTPS (production).
# Leave "false" for local development (localhost) — otherwise the session cookie
# will not be sent and login will immediately fail.
SESSION_COOKIE_SECURE=false

# Public URL of the application (no trailing slash).
# Used for generating absolute links in emails and magic links.
# Example: https://aspidus-crm.onrender.com
APP_BASE_URL=

# ── Data Storage ─────────────────────────────────────────────

# Directory where SQLite databases, encryption keys, and uploaded files are stored.
# On Render/Heroku with a persistent disk, set this to the disk mount path.
# Locally it defaults to the project root.
DATA_DIR=

# Maximum upload size in megabytes (default: 100).
MAX_CONTENT_LENGTH=100

# ── Supabase Integration (optional — for B2B portal auth) ────

# Enable Supabase authentication for the B2B portal.
# When "false", the portal uses legacy OTP login.
USE_SUPABASE_AUTH=false

# Enable Supabase Storage for file uploads (offer PDFs, partner docs, portal uploads).
# Requires SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
USE_SUPABASE_STORAGE=false

# Supabase project URL (e.g. https://xxxxx.supabase.co)
SUPABASE_URL=

# Supabase service role key — full admin access (KEEP SECRET!)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret — used to verify Supabase auth tokens
SUPABASE_JWT_SECRET=

# Supabase anonymous/public key — used for client-side Supabase calls
SUPABASE_ANON_KEY=

# ── Webhooks (optional) ─────────────────────────────────────

# Secret for validating incoming Supabase webhook requests.
# Must be at least 32 characters. If not set, the webhook endpoint rejects all requests.
WEBHOOK_SECRET=
